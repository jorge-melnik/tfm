{
  "name": "deaca api",
  "dockerComposeFile": ["../../docker-compose.yaml"],
  "service": "api",
  "workspaceFolder": "/deaca/api",
  "remoteUser": "laravel",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"],
      "settings": {
        "git.openRepositoryInParentFolders": "always",
        "git.config": {
          "safe.directory": "tfm"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "intelephense.files.exclude": ["**/.git/**", "**/node_modules/**"]
      }
    }
  }
}
