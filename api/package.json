{
  "type": "module",
  "name": "agroeco",
  "version": "1.0.0",
  "description": "Api para App De Acá!.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "test": "node --import tsx --test --experimental-test-coverage \"test/**/*.ts\"",
    "testc8": "c8 --all --src ./src --reporter=text --reporter=text-summary node --import tsx --test \"test/**/*.ts\"",
    "start": "node dist/server.js",
    "aceptar-transferencias": "tsx src/scripts/simulacion/aceptar.ts",
    "etl-ideuy": "tsx src/etl/ideuy/etl.ts"
  },
  "keywords": [
    ""
  ],
